# Non-Production Environment Configuration Template
# DO NOT place real banking credentials or production URLs in this file.

NODE_ENV=test
COREBANK_ENVIRONMENT=qa
COREBANK_BASE_URL=https://qa-banking.bankdomain.internal
COREBANK_API_URL=https://qa-api.bankdomain.internal/v1
COREBANK_RECON_URL=https://qa-recon.bankdomain.internal/v1

# Read-only test environment database connection (Placeholders only)
COREBANK_DB_HOST=qa-db-readonly.bankdomain.internal
COREBANK_DB_PORT=5432
COREBANK_DB_NAME=corebank_qa
COREBANK_DB_USER=qa_readonly_service_user
COREBANK_DB_PASS=REDACTED_PASSWORD_IN_VAULT

# CI/CD Execution Flags
CI=false
PLAYWRIGHT_WORKERS=1
PLAYWRIGHT_HEADLESS=true
TRACE_ON_FAILURE=true

# Non-Production Environment Configuration Template
# DO NOT place real banking credentials or production URLs in this file.

NODE_ENV=test
COREBANK_ENVIRONMENT=qa
COREBANK_BASE_URL=https://qa-banking.bankdomain.internal
COREBANK_API_URL=https://qa-api.bankdomain.internal/v1
COREBANK_RECON_URL=https://qa-recon.bankdomain.internal/v1

# Read-only test environment database connection (Placeholders only)
COREBANK_DB_HOST=qa-db-readonly.bankdomain.internal
COREBANK_DB_PORT=5432
COREBANK_DB_NAME=corebank_qa
COREBANK_DB_USER=qa_readonly_service_user
COREBANK_DB_PASS=REDACTED_PASSWORD_IN_VAULT

# CI/CD Execution Flags
CI=false
PLAYWRIGHT_WORKERS=1
PLAYWRIGHT_HEADLESS=true
TRACE_ON_FAILURE=true

# ── Auto CI/CD (push-and-trigger-ci) ─────────────────────────────────────────
# Set these three values so that `npm run agent` automatically commits, pushes,
# and triggers the GitHub Actions workflow after each evaluation run.
#
# GITHUB_TOKEN  – Personal Access Token (classic) or fine-grained PAT with:
#                   Contents: write
#                   Actions:  write
#                 Store in a secrets manager or CI secret — NEVER commit the
#                 real token to version control.
# GITHUB_OWNER  – GitHub username or org that owns the repository.
# GITHUB_REPO   – Repository name (without the owner prefix).
# GITHUB_BRANCH – Branch to push to and dispatch against (default: main).
# GITHUB_WORKFLOW_FILE – Workflow filename inside .github/workflows/
#                        (default: corebank-qa-agent.yml).
GITHUB_TOKEN=REPLACE_WITH_YOUR_PERSONAL_ACCESS_TOKEN
GITHUB_OWNER=Tejkumar-hacker
GITHUB_REPO=whitePaperAgent
GITHUB_BRANCH=main
GITHUB_WORKFLOW_FILE=corebank-qa-agent.yml
